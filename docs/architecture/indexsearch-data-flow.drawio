          <mxGeometry x="460" y="40" width="830" height="140" as="geometry" />
        </mxCell>
        <mxCell id="publicUi" value="public-ui&#10;&#10;NO auth library at all&#10;cannot obtain a token" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f1efe8;strokeColor=#5f5e5a;fontSize=11;verticalAlign=top;spacingTop=4" vertex="1" parent="1">
          <mxGeometry x="500" y="80" width="230" height="80" as="geometry" />
        </mxCell>
        <mxCell id="adminUi" value="admin-ui&#10;&#10;oidc-client-ts — users sign in&#10;unchanged by this work" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f1efe8;strokeColor=#5f5e5a;fontSize=11;verticalAlign=top;spacingTop=4" vertex="1" parent="1">
          <mxGeometry x="800" y="80" width="250" height="80" as="geometry" />
        </mxCell>

        <!-- ============ ZONE: HOSTS ============ -->
        <mxCell id="zoneHosts" value="Deployed services (.NET hosts) — separate processes" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#999999;dashed=1;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;fontSize=12;fontStyle=2;fontColor=#666666" vertex="1" parent="1">
          <mxGeometry x="40" y="220" width="1790" height="1230" as="geometry" />
        </mxCell>

        <!-- === Admin.Api === -->
        <mxCell id="adminApi" value="Bfs.Iop.Admin.Api&#10;/api/Catalog/search" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eeedfe;strokeColor=#534ab7;fontColor=#3c3489;fontSize=12;fontStyle=1;verticalAlign=top;spacingTop=6" vertex="1" parent="1">
