<mxfile host="app.diagrams.net" version="24.7.17">
  <diagram id="indexsearch-data-flow" name="IndexSearch data flow">
    <mxGraphModel dx="2400" dy="1600" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1654" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0" />
