        <mxCell id="adminBiz" value="Bfs.Iop.Admin.Business&#10;&#10;SearchCommandHandler · SearchCountCommandHandler&#10;(Admin.Api&#39;s ConceptViewController for code-list search)&#10;&#10;They inject IIopCoreApiClient DIRECTLY — exactly as&#10;before this migration. UNCHANGED: git reports no diff&#10;in src/Admin at all." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1f5ee;strokeColor=#0f6e56;fontColor=#085041;fontSize=10;verticalAlign=top;spacingTop=4" vertex="1" parent="1">
          <mxGeometry x="420" y="350" width="400" height="140" as="geometry" />
        </mxCell>

        <!-- === Partner.Api — the public API, same provider pattern, same flag === -->
        <mxCell id="partnerApi" value="Bfs.Iop.Partner.Api — PUBLIC API&#10;/api/Search · codelist search + export" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eeedfe;strokeColor=#534ab7;fontColor=#3c3489;fontSize=11;fontStyle=1;verticalAlign=top;spacingTop=6" vertex="1" parent="1">
          <mxGeometry x="800" y="260" width="290" height="60" as="geometry" />
        </mxCell>

