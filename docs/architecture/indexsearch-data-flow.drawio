        <mxCell id="coreApiClient" value="Bfs.Iop.Core.ApiClient&#10;&#10;NSwag-generated&#10;ITokenRetriever → bearer" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1f5ee;strokeColor=#0f6e56;fontColor=#085041;fontSize=11;verticalAlign=top;spacingTop=4" vertex="1" parent="1">
          <mxGeometry x="560" y="530" width="220" height="90" as="geometry" />
        </mxCell>
        <mxCell id="isSearchClient" value="IIndexSearchSearchClient&#10;(Bfs.Iop.IndexSearch.ApiClient)&#10;&#10;used by CORE ONLY&#10;hand-written · bearer via&#10;DelegatingHandler" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1f5ee;strokeColor=#0f6e56;fontColor=#085041;fontSize=11;verticalAlign=top;spacingTop=4" vertex="1" parent="1">
          <mxGeometry x="950" y="790" width="250" height="120" as="geometry" />
        </mxCell>

        <!-- === Core.Api === -->
        <mxCell id="coreApi" value="Bfs.Iop.Core.Api — THE GATEWAY (internal only)&#10;/api/Search · /api/Search/count · code-list search + export · CRUD&#10;Same routes as before — the generated client is byte-identical.&#10;Owns NO index: reads are proxied, writes are queued." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eeedfe;strokeColor=#534ab7;fontColor=#3c3489;fontSize=11;fontStyle=1;verticalAlign=top;spacingTop=6" vertex="1" parent="1">
          <mxGeometry x="420" y="660" width="480" height="90" as="geometry" />
        </mxCell>
        <mxCell id="coreBiz" value="Bfs.Iop.Core (business)&#10;&#10;Datasets / DataServices / PublicServices /&#10;Concepts / MappingTables services&#10;&#10;Depends on Bfs.Iop.Search.Abstractions ONLY.&#10;No search-engine reference of any kind." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1f5ee;strokeColor=#0f6e56;fontColor=#085041;fontSize=11;verticalAlign=top;spacingTop=4" vertex="1" parent="1">
          <mxGeometry x="80" y="790" width="330" height="135" as="geometry" />
        </mxCell>

        <!-- === Forwarding === -->
        <mxCell id="fwd" value="Bfs.Iop.Core.IndexForwarding — binds the ports to IndexSearch&#10;&#10;ForwardingCatalogIndexService     writes → enqueue only&#10;ForwardingCodeListEntryIndexService  (no inner engine)&#10;RemoteCodeListEntrySearchService  reads → HTTP + bearer&#10;IndexSearchDispatcher — bounded Channel, DropOldest&#10;IndexForwardingSenderHostedService&#10;&#10;Missing BaseUrl THROWS at startup — see callout." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#faece7;strokeColor=#993c1d;fontColor=#712b13;fontSize=11;verticalAlign=top;spacingTop=4" vertex="1" parent="1">
          <mxGeometry x="450" y="790" width="450" height="165" as="geometry" />
        </mxCell>

        <!-- === IndexSearch.Api === -->
        <mxCell id="isApi" value="Bfs.Iop.IndexSearch.Api — the new service" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eeedfe;strokeColor=#534ab7;fontColor=#3c3489;fontSize=12;fontStyle=1;verticalAlign=top;spacingTop=6;align=center" vertex="1" parent="1">
          <mxGeometry x="1000" y="980" width="810" height="360" as="geometry" />
        </mxCell>
        <mxCell id="isRead" value="Read side&#10;&#10;SearchController&#10;  GET /api/Search&#10;  GET /api/Search/count&#10;ConceptsController&#10;  GET .../codelist-entries/search&#10;&#10;[AllowAnonymous] but user-scoped:&#10;role + agencies come from the token" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e6f1fb;strokeColor=#185fa5;fontColor=#0c447c;fontSize=10;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4" vertex="1" parent="1">
          <mxGeometry x="1020" y="1030" width="255" height="175" as="geometry" />
        </mxCell>
        <mxCell id="isWrite" value="Write side&#10;&#10;IndexController&#10;  POST /api/Index/{datasets,…}&#10;  DELETE /api/Index/{catalog,…}&#10;  POST /api/Index/rebuild&#10;  GET  /api/Index (status)&#10;&#10;IndexApiSecretAttribute&#10;X-Api-Key · FAILS CLOSED" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fcebeb;strokeColor=#a32d2d;fontColor=#791f1f;fontSize=10;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4" vertex="1" parent="1">
          <mxGeometry x="1295" y="1030" width="245" height="175" as="geometry" />
        </mxCell>
        <mxCell id="isQueue" value="Ingest pipeline&#10;&#10;IIndexEventQueue&#10;  bounded Channel → 429 when full&#10;IndexEventProcessor&#10;  single consumer, coalesces&#10;IndexReconciler&#10;  payload → index&#10;  null → de-index&#10;IndexBuilderHostedService&#10;  startup · 6h · on request&#10;IndexBuildState (single-flight)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fbeaf0;strokeColor=#993556;fontColor=#72243e;fontSize=10;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4" vertex="1" parent="1">
          <mxGeometry x="1555" y="1030" width="235" height="200" as="geometry" />
        </mxCell>
        <mxCell id="isMapping" value="CatalogSearchQueryService · CatalogSearchCountQueryService · SearchResultMappingExtensions&#10;resolve hits into SearchResultModel using Core's vocabularies (InternalsVisibleTo)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#534ab7;fontColor=#3c3489;fontSize=10;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4" vertex="1" parent="1">
          <mxGeometry x="1020" y="1250" width="770" height="60" as="geometry" />
        </mxCell>

        <!-- === engine === -->
        <mxCell id="engine" value="Bfs.Iop.Search.Elasticsearch — the engine&#10;&#10;CatalogQueryBuilder — auth clause + drill-sideways aggs&#10;CatalogDocumentFactory · CatalogIndexMapping&#10;ElasticsearchCatalogIndexService / …IndexBuilderService&#10;CodeList/* · EsRest · EsAnalysis" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#faece7;strokeColor=#993c1d;fontColor=#712b13;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6" vertex="1" parent="1">
          <mxGeometry x="870" y="1500" width="405" height="120" as="geometry" />
        </mxCell>
        <mxCell id="ports" value="Bfs.Iop.Search.Abstractions&#10;ICatalogIndexService · ICodeListEntryIndexService&#10;ICodeListEntrySearchService · IIndexBuilderService&#10;&#10;TWO implementations: the real engine (here) and&#10;Core&#39;s remote/forwarding one (top left)." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eaf3de;strokeColor=#3b6d11;fontColor=#27500a;fontSize=10;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6" vertex="1" parent="1">
          <mxGeometry x="470" y="1500" width="345" height="115" as="geometry" />
        </mxCell>
        <mxCell id="engineOnly" value="Referenced by EXACTLY ONE project.&#10;Not by Core, not by Admin, not by any client.&#10;This is what &quot;the engine is isolated&quot; means." style="text;html=1;align=left;fontSize=10;fontColor=#993c1d;fontStyle=2;verticalAlign=top" vertex="1" parent="1">
          <mxGeometry x="870" y="1630" width="405" height="46" as="geometry" />
        </mxCell>

