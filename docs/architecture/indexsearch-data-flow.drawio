          <mxGeometry x="132" y="68" width="270" height="20" as="geometry" />
        </mxCell>
        <mxCell id="legDash" style="endArrow=blockThin;html=1;strokeWidth=2;strokeColor=#1a73e8;dashed=1;endFill=1" edge="1" parent="1">
