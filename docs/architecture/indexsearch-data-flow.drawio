        <mxCell id="legDashTxt" value="HTTP call (crosses a process boundary)" style="text;html=1;align=left;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="132" y="96" width="270" height="20" as="geometry" />
        </mxCell>
        <mxCell id="legDot" style="endArrow=blockThin;html=1;strokeWidth=2;strokeColor=#7f3fbf;dashed=1;dashPattern=1 3;endFill=1" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="56" y="136" as="sourcePoint" /><mxPoint x="126" y="136" as="targetPoint" /></mxGeometry>
        </mxCell>
        <mxCell id="legDotTxt" value="Data-store I/O (Postgres, Elasticsearch, object store)" style="text;html=1;align=left;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="132" y="124" width="270" height="20" as="geometry" />
        </mxCell>
        <mxCell id="legNote" value="A TypeScript frontend can only ever use a dashed edge.&#10;It cannot reference a .NET project — that is why the&#10;Elasticsearch engine can never appear in the frontend." style="text;html=1;align=left;fontSize=10;fontColor=#666666;verticalAlign=top" vertex="1" parent="1">
          <mxGeometry x="52" y="150" width="360" height="36" as="geometry" />
        </mxCell>

        <!-- ============ ZONE: FRONTEND ============ -->
