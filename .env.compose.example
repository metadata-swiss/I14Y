# Local development only. These credentials are public demo values, not secrets.
POSTGRES_DB=i14y
POSTGRES_USER=i14y
POSTGRES_PASSWORD=i14y
POSTGRES_HOST=postgres

# Local development only. These credentials are public demo values, not secrets.
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin
KEYCLOAK_ISSUER=http://keycloak.localhost:8080/realms/i14y-local
KEYCLOAK_AUTHORITY_URL=http://keycloak.localhost:8080/realms/i14y-local

# Local development only. These credentials are public demo values, not secrets.
FUSEKI_USERNAME=admin
FUSEKI_PASSWORD=admin

# Local development only. This is a public demo value, not a secret.
PARTNER_API_SECRET=local-partner-secret
EIAM_ISSUER=http://host.docker.internal:8080/realms/eiam-local

# Optional corporate build settings. Uncomment and replace these example values
# only when your network requires a proxy, a custom CA, or a private Node registry.
# I14Y_BUILD_HTTP_PROXY=http://proxy.example.invalid:8080
# I14Y_BUILD_HTTPS_PROXY=http://proxy.example.invalid:8080
# I14Y_BUILD_NO_PROXY=localhost,127.0.0.1,core-api,admin-api,partner-api,iri-api,postgres,fuseki,keycloak,keycloak.localhost
# I14Y_CORPORATE_CA_FILE=build/certificates/corporate-ca.crt
# I14Y_CORPORATE_CA_CHAIN_FILE=build/certificates/corporate-ca-chain.crt
# I14Y_FRONTEND_NODE_IMAGE=registry.example.invalid/node:24-bookworm-slim
