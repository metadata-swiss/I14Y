POSTGRES_DB=i14y
POSTGRES_USER=i14y
POSTGRES_PASSWORD=i14y
POSTGRES_HOST=host.docker.internal

KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin
KEYCLOAK_ISSUER=http://keycloak.localtest.me:8080/realms/i14y-local
KEYCLOAK_AUTHORITY_URL=http://keycloak.localtest.me:8080/realms/i14y-local

FUSEKI_USERNAME=admin
FUSEKI_PASSWORD=admin

PARTNER_API_SECRET=local-partner-secret
EIAM_ISSUER=http://host.docker.internal:8080/realms/eiam-local

# Corporate network settings for backend NuGet restore during Docker build
HTTP_PROXY=http://proxy-bvcol.admin.ch:8080
HTTPS_PROXY=http://proxy-bvcol.admin.ch:8080
NO_PROXY=localhost,127.0.0.1,core-api,admin-api,partner-api,iri-api,postgres,fuseki,keycloak,keycloak.localtest.me
CORPORATE_CA_FILE=
CORPORATE_CA_CHAIN_FILE=
# Example values when your proxy intercepts TLS (use forward slashes)
# CORPORATE_CA_FILE=build/certificates/BIT_Proxy_CA_06_C.crt
# CORPORATE_CA_CHAIN_FILE=build/certificates/BIT_Proxy_Root_CA_01.crt

# Optional corporate node registry for frontend builds
# FRONTEND_NODE_IMAGE=repo.bit.admin.ch:8444/node:24-bookworm-slim
FRONTEND_NODE_IMAGE=node:24-bookworm-slim
