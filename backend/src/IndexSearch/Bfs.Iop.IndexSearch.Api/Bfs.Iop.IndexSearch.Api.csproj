    <PackageReference Include="Azure.Extensions.AspNetCore.Configuration.Secrets" Version="1.5.1" />
    <PackageReference Include="Microsoft.Azure.AppConfiguration.AspNetCore" Version="8.5.0" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="10.2.3" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="$(AssemblyName).UnitTests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Data\Bfs.Iop.DataAccess.Relational\Bfs.Iop.DataAccess.Relational.csproj" />
    <ProjectReference Include="..\Bfs.Iop.IndexSearch.Data\Bfs.Iop.IndexSearch.Data.csproj" />
    <ProjectReference Include="..\Bfs.Iop.IndexSearch.Elasticsearch\Bfs.Iop.IndexSearch.Elasticsearch.csproj" />
  </ItemGroup>

</Project>
