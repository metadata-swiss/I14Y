{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Bfs.Iop.IndexSearch": "Debug"
    }
  },

  // Same database IOP Core uses locally. The password is deliberately absent: supply it through
  // user secrets when running from the IDE, or the postgres__client__password environment variable
  // when running in Docker. Startup fails with "Missing configuration value: 'password'" if neither
  // is set, which is a clearer failure than an empty password reaching Npgsql.
  "postgresCredentialsSectionKey": "postgres:client",
  "postgres": {
    "client": {
      "hostname": "127.0.0.1",
      "port": "15432",
      "database": "dsisbfsdcat",
      "username": "pgsql_preprod_shared_admin"
    }
  },

  // The object store is genuinely used: the dataset "hasStructure" flag comes from listing the
  // structures container (IDatasetModelFileProcessService.GetAllDatasetIdsWithStructures), which is
  // what feeds the Structures facet. Mirrors IOP Core's own settings; supply AccessKey and Secret
  // through user secrets, exactly as Core does.
  //
  // Without real credentials the container listing fails, the index builder logs it and continues
  // with an empty list, and every dataset is indexed as having no structure — so the Structures
  // filter comes back empty.
  "ObjectStoreConfigurationLocation": {
    "Endpoint": "ObjectStoreConfiguration:Endpoint",
    "AccessKey": "ObjectStoreConfiguration:AccessKey",
    "Secret": "ObjectStoreConfiguration:Secret"
  },
  "ObjectStoreConfiguration": {
    "Service": "ECS-IOP-PreProd",
    "AccessKey": "USE SECRETS",
    "Secret": "USE SECRETS",
    "Endpoint": "ecspr00.sz.admin.ch:9021",
    "HttpTracing": false,
    "UseSsl": true
  },

  "Elasticsearch": {
    "Uri": "http://localhost:9200",
    "CatalogIndexName": "catalog",
    "CodeListIndexName": "codelist",
    "RecreateIndexOnStartup": true
  },

  "IndexSearch": {
    // Must match IndexSearchClient:Secret in IOP Core's appsettings.Development.json.
    "Secret": "local-indexsearch-secret",
    "QueueCapacity": 10000,
    "BatchSize": 200,
    "FullReindexIntervalHours": 6,
    "BuildIndexOnStartup": true
  },

  "CorsOrigins": {
    "Urls": "http://localhost:4200,http://localhost:5022"
  },

  "I14Y": {
    "IriBaseUrl": "http://localhost:8003"
  }
}
