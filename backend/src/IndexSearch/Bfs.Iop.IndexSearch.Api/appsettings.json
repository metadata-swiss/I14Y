{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",

  "postgresCredentialsSectionKey": "#{POSTGRES_CREDENTIALS_SECTION_KEY}#",

  "Elasticsearch": {
    "Uri": "#{ELASTICSEARCH_URI}#",
    "CatalogIndexName": "#{ELASTICSEARCH_CATALOG_INDEX_NAME}#",
    "CodeListIndexName": "#{ELASTICSEARCH_CODELIST_INDEX_NAME}#",
    // A literal, not a #{token}#, and deliberately so: this is a product decision that is the same
    // in every environment, not an environment-specific value. It also removes a startup crash —
    // these tokens are placeholders that Azure App Configuration overrides at runtime, they are NOT
    // substituted textually, so an App Config that never defined this key left the literal
    // "#{ELASTICSEARCH_RECREATE_INDEX_ON_STARTUP}#" to be bound to a bool. App Config can still
    // override this value if an environment ever needs it off.
    "RecreateIndexOnStartup": true
  },

  "IndexSearch": {
    "Secret": "#{INDEXSEARCH_SECRET}#",
    "FullReindexIntervalHours": "#{INDEXSEARCH_FULL_REINDEX_INTERVAL_HOURS}#"
  },

  "CorsOrigins": {
    "Urls": "#{CORS_ORIGINS_URLS}#"
  },

  "Keycloak": {
    "audience": "#{KEYCLOAK_AUDIENCE}#"
  },

  "Eiam": {
    "audience": "#{EIAM_AUDIENCE}#"
  }
}
