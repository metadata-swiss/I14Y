{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning",
      "System.Net.Http": "Warning"
    }
  },
  "AllowedHosts": "*",
  "postgresCredentialsSectionKey": "#{POSTGRES_CREDENTIALS_SECTION_KEY}#",
  "IndexSearch": {
    "ApiKey": "#{INDEXSEARCH_API_KEY}#",
    "CreateIndicesOnStartup": true,
    "ReindexOnStartup": "#{INDEXSEARCH_REINDEX_ON_STARTUP}#",
    "ResetOnStartup": false,
    "ReindexBatchSize": 1000,
    "ForceMergeAfterReindex": true
  },
  "Elasticsearch": {
    "Uri": "#{ELASTICSEARCH_URI}#",
    "Username": "#{ELASTICSEARCH_USERNAME}#",
    "Password": "#{ELASTICSEARCH_PASSWORD}#",
    "CatalogIndexName": "i14y-catalog",
    "CodeListIndexName": "i14y-codelist"
  }
}
