{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning",
      "System.Net.Http": "Warning"
    }
  },
  "AllowedHosts": "*",
  "postgresCredentialsSectionKey": "#{POSTGRES_CREDENTIALS_SECTION_KEY}#",

  "Keycloak": {
    "audience": "#{KEYCLOAK_AUDIENCE}#",
    "issuers": [ "#{KEYCLOAK_STS_SERVER}#" ]
  },

  "Eiam": {
    "audience": "#{EIAM_AUDIENCE}#",
    "issuers": [ "#{EIAM_SERVER}#" ]
  },
  "ReindexSchedule": {
    "IntervalHours": 24,
    "FirstSlotHourUtc": 3
  },

  "Elasticsearch": {
    "Uri": "#{ELASTICSEARCH_URI}#",
    "Username": "#{ELASTICSEARCH_USERNAME}#",
    "Password": "#{ELASTICSEARCH_PASSWORD}#",
    "CatalogIndexName": "i14y-catalog",
    "CodeListIndexName": "i14y-codelist"
  },

  "SearchScoring": {
    "Catalog": {
      "FieldWeights": {
        "title": 5,
        "name": 5,
        "identifier": 5,
        "version": 5,
        "keyword": 1,
        "description": 0.3,
        "contactPointFn": 0.2,
        "contactPointHasAddress": 0.2,
        "contactPointNote": 0.2,
        "contactPointHasTelephone": 0.2,
        "dataOwner": 0.2,
        "responsiblePersonName": 0.2,
        "responsibleDeputyName": 0.2
      },
      "PartialMatchBoost": 0.75,
      "PartialMatchMinimumShouldMatch": "75%",
      "RegistrationStatusWeights": {
        "Incomplete": 95,
        "Candidate": 98,
        "Recorded": 100,
        "Qualified": 102,
        "Standard": 105,
        "PreferredStandard": 110,
        "Superseded": 90,
        "Retired": 85
      }
    },
    "CodeList": {
      "CodeBoost": 20,
      "NameBoost": 16,
      "DescriptionBoost": 12,
      "AnnotationBoost": 8,
      "NgramMinimumShouldMatch": "60%",
      "SingleEditMaxTermLength": 4
    }
  }
}
