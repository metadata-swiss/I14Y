<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.msbuild" Version="8.0.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="NUnit" Version="4.6.1" />
    <PackageReference Include="NUnit3TestAdapter" Version="6.1.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.0.1" />
    <PackageReference Include="AwesomeAssertions" Version="9.4.0" />
    <PackageReference Include="NSubstitute" Version="5.3.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- The only project that references every layer at once. The whole point is to run the pipeline
         end to end: database -> mapping -> orchestration -> Elasticsearch. -->
    <ProjectReference Include="..\..\Data\Bfs.Iop.DataAccess.Relational\Bfs.Iop.DataAccess.Relational.csproj" />
    <ProjectReference Include="..\Bfs.Iop.IndexSearch.Business\Bfs.Iop.IndexSearch.Business.csproj" />
    <ProjectReference Include="..\Bfs.Iop.IndexSearch.Contracts\Bfs.Iop.IndexSearch.Contracts.csproj" />
    <ProjectReference Include="..\Bfs.Iop.IndexSearch.Data\Bfs.Iop.IndexSearch.Data.csproj" />
    <ProjectReference Include="..\Bfs.Iop.IndexSearch.Elasticsearch\Bfs.Iop.IndexSearch.Elasticsearch.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="NUnit.Framework" />
  </ItemGroup>

</Project>
