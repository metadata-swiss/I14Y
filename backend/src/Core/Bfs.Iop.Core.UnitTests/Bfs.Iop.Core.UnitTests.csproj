  <ItemGroup>
    <ProjectReference Include="..\Bfs.Iop.Core\Bfs.Iop.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="NUnit.Framework" />
  </ItemGroup>

