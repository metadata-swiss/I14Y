<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="FluentValidation.DependencyInjectionExtensions" Version="11.9.2" />
    <PackageReference Include="MediatR" Version="12.5.0" />
    <PackageReference Include="Slugify.Core" Version="5.1.1" />
    <PackageReference Include="System.Linq.Async" Version="7.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Bfs.Iop.Core.Abstractions\Bfs.Iop.Core.Abstractions.csproj" />
    <ProjectReference Include="..\Bfs.Iop.Core.Common\Bfs.Iop.Core.Common.csproj" />
    <ProjectReference Include="..\Bfs.Iop.Core.Data\Bfs.Iop.Core.Data.csproj" />
    <ProjectReference Include="..\Bfs.Iop.Core.FileStorage\Bfs.Iop.Core.FileStorage.csproj" />
    <ProjectReference Include="..\Bfs.Iop.Core.LinkedData\Bfs.Iop.Core.LinkedData.csproj" />
    <!-- The search service's published client, consumed the same way Admin, Iri and Partner consume
         Bfs.Iop.Core.ApiClient: a business layer calling another service through its client. Core
         owns no index, so this is its only route to search, for reads and writes alike.

         It deliberately replaces a reference to Bfs.Iop.Search.Abstractions. Those are the search
         service's internal engine contracts; Core was binding them only so a wrapper in
         Bfs.Iop.Core.IndexForwarding could translate them back into calls on this client. Core's
         write path uses its own ICatalogIndexWriter / ICodeListEntryIndexWriter instead. -->
    <ProjectReference Include="..\..\IndexSearch\Bfs.Iop.IndexSearch.ApiClient\Bfs.Iop.IndexSearch.ApiClient.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="$(AssemblyName).UnitTests" />
    <!-- Implements the internal ICatalogIndexWriter / ICodeListEntryIndexWriter in
         Services/Contracts. Those are internal because they are Core's own narrowed view of what it
         does to an index, not a contract anyone else should bind to. -->
    <InternalsVisibleTo Include="Bfs.Iop.Core.IndexForwarding" />
    <!-- Its tests assert which contract each forwarder is registered under, so they need to name the
         contract, not just the implementation. -->
    <InternalsVisibleTo Include="Bfs.Iop.Core.IndexForwarding.UnitTests" />
    <InternalsVisibleTo Include="$(AssemblyName).Sync" />
    <InternalsVisibleTo Include="DynamicProxyGenAssembly2" />
  </ItemGroup>

</Project>
