{
    "AllowedHosts": "*",
    "ReleaseVersion": "#{RELEASE_VERSION}#",
    "Serilog": {
        "Using": [ "Serilog.Sinks.Console" ],
        "MinimumLevel": {
            "Default": "Information",
            "Override": {
                "Microsoft": "Warning",
                "Microsoft.Hosting.Lifetime": "Information",
                "Steeltoe.Management.Tracing.Observer.AspNetCoreMvcViewObserver": "Warning",
                "Azure.Identity": "Information",
                "Azure.Core": "Information",
                "Azure.Data.AppConfiguration": "Information",
                "Azure.Security.KeyVault": "Information",
                "Serilog.AspNetCore.RequestLoggingMiddleware": "Information"
            }
        }
    },
    "CorsOrigins": {
        "Urls": "#{CORS_ALLOWED_ORIGINS}#"
    },
    "Keycloak": {
        "issuers": [
            "#{KEYCLOAK_STS_SERVER}#"
        ]
    },
    "Eiam": {
        "issuers": [
            "#{EIAM_SERVER}#"
        ]
    },
    "DcatUrl": "#{DCAT_API_BASE_URL}#",
    "EIAMConfig": {
        "Uri": "#{EIAM_CONFIG_URI}#",
        "Certificate": "#{EIAM_CONFIG_CERTIFICATE}#",
        "CertificatePassword": "#{EIAM_CONFIG_CERTIFICATE_PASSWORD}#"
    },
    "PartnerApi": {
        "Secret": "#{PARTNER_API_SECRET}#"
    },
    "GeocatClient": {
        "ApiBaseUrl": "#{GEOCAT_API_BASE_URL}#"
    },
    "OpenDataClient": {
        "ApiBaseUrl": "#{OGD_API_BASE_URL}#",
        "LinkBaseUrl": "#{OGD_LINK_BASE_URL}#"
    },
    "Localizer": {
        "OrderedFallbackLanguageCodes": [ "DE", "FR", "IT", "EN" ]
    }
}