    "/api/Datasets/by-identifier/{identifier}": {
      "get": {
        "tags": [
          "Datasets"
        ],
        "summary": "Gets the DCAT dataset with the given identifier.",
        "parameters": [
          {
            "name": "identifier",
            "in": "path",
            "description": "",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
