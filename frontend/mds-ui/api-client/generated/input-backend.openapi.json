{
  "openapi": "3.0.4",
  "info": {
    "title": "opendata.swiss: iop-core (read-only)",
    "description": "The iop-core endpoints that opendata.swiss uses, forwarded by its server. Anonymous, GET only.",
    "version": "v1"
  },
  "servers": [
    {
      "url": "/input-backend"
    }
  ],
  "paths": {
    "/api/Search": {
      "get": {
        "tags": [
          "Search"
        ],
        "summary": "Returns the search results for the given filters.",
        "parameters": [
          {
            "name": "language",
            "in": "query",
            "description": "The language to use for the search",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "query",
            "in": "query",
            "description": "The search query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "accessRights",
            "in": "query",
            "description": "Only results with one of the specified access rights (PUBLIC, NON_PUBLIC, RESTRICTED) are returned",
            "schema": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          {
            "name": "attributedAgents",
            "in": "query",
            "description": "Only results with a qualified attribution to one of the specified agents (by identifier) are returned",
            "schema": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          {
            "name": "businessEvents",
            "in": "query",
            "description": "Only results corresponding to one of the specified business events are returned",
            "schema": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          {
            "name": "conceptValueTypes",
            "in": "query",
            "description": "Only results corresponding to one of the specified IOP concept value types (CodeList, Date, Numeric, String) are returned.",
            "schema": {
              "type": "array",
              "items": {
                "$ref": "#/components/schemas/ConceptType"
              }
            }
          },
          {
            "name": "formats",
            "in": "query",
            "description": "Only results with at least one distribution providing one of the specified formats are returned",
            "schema": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          {
            "name": "levels",
            "in": "query",
            "description": "Only results with one of the specified publication levels (Unit, I14Y Public) are returned",
            "schema": {
              "type": "array",
              "items": {
                "$ref": "#/components/schemas/PublicationLevel"
              }
            }
          },
          {
            "name": "levelProposals",
            "in": "query",
            "description": "Only results with the proposal publication (I14Y Public) is returned",
            "schema": {
              "type": "array",
              "items": {
                "$ref": "#/components/schemas/PublicationLevel"
              }
            }
          },
          {
            "name": "lifeEvents",
            "in": "query",
            "description": "Only results corresponding to one of the specified life events are returned",
            "schema": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          {
            "name": "publishers",
            "in": "query",
            "description": "Only results with one of the specified publishers are returned",
            "schema": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          {
            "name": "statuses",
            "in": "query",
            "description": "Only results with one of the specified registration statuses are returned",
            "schema": {
              "type": "array",
              "items": {
                "$ref": "#/components/schemas/RegistrationStatus"
              }
            }
          },
          {
            "name": "statusProposals",
            "in": "query",
            "description": "Only results with one of the proposals registration statuses are returned",
            "schema": {
              "type": "array",
              "items": {
                "$ref": "#/components/schemas/RegistrationStatus"
              }
            }
          },
          {
            "name": "structure",
            "in": "query",
            "description": "Only results for datasets are returned.",
            "schema": {
              "$ref": "#/components/schemas/SearchStructureOption"
            }
          },
          {
            "name": "themes",
            "in": "query",
            "description": "Only results corresponding to one of the specified themes are returned",
            "schema": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          {
            "name": "types",
            "in": "query",
            "description": "Only results with one of the specified types are returned",
            "schema": {
              "type": "array",
              "items": {
                "$ref": "#/components/schemas/SearchResourceType"
              }
            }
          },
          {
            "name": "page",
            "in": "query",
            "description": "The number of the result page to return",
            "schema": {
              "type": "integer",
              "format": "int32"
            },
            "example": 1
          },
          {
            "name": "pageSize",
            "in": "query",
            "description": "The size of each result page",
            "schema": {
              "type": "integer",
              "format": "int32"
            },
            "example": 25
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/SearchResultModel"
                  }
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
