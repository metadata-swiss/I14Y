              "items": {
                "type": "string"
              }
            }
          },
          {
            "name": "publishers",
            "in": "query",
            "description": "Only results with one of the specified publishers are counted",
            "schema": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          {
            "name": "statuses",
            "in": "query",
            "description": "Only results with one of the specified registration statuses are counted",
            "schema": {
              "type": "array",
              "items": {
                "$ref": "#/components/schemas/RegistrationStatus"
              }
            }
          },
          {
            "name": "statusProposals",
            "in": "query",
            "description": "Only results with one of the proposals registration statuses are returned",
            "schema": {
              "type": "array",
