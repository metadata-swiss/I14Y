<#successComplete>
  a earl:TestCase ;
  rdfs:label "Submitted successfully (complete)" ;
  <#request> [
    a tuner:Request ;
      tuner:url </api/showcases> ;
      tuner:method "POST" ;
      tuner:header ( "Accept-Language" "de" ) ;
      tuner:body [
        tuner:form ( "title" "Test: Complete sample" ) ;
        tuner:form ( "type" "https://opendata.swiss/vocabulary/showcase-type/application" ) ;
        tuner:form ( "url" "http://example.com/showcase" ) ;
        tuner:form ( "images" <file:assets/Rdf_logo.svg.png> ) ;
        tuner:form ( "datasets[https://opendata.swiss/set/data/hepatitis_b-abteilung-uebertragbare-krankheiten]" "Hepatitis B" ) ;
        tuner:form ( "themes" "http://publications.europa.eu/resource/authority/data-theme/INTR" ) ;
        tuner:form ( "keywords" "test" ) ;
        tuner:form ( "keywords" "sugus" ) ;
        tuner:form ( "createdBy" "John Doe" ) ;
        tuner:form ( "contactDetails.name" "John Doe" ) ;
        tuner:form ( "contactDetails.email" "john@Doe.pro" ) ;
        tuner:form ( "contactDetails.github" "jd" ) ;
        tuner:form ( "more.whoAreYou" "Independent researcher" ) ;
        tuner:form ( "more.goal" "To help others" ) ;
        tuner:form ( "more.why" "No prior research" ) ;
        tuner:form ( "more.users" "All citizens" ) ;
        tuner:form ( "more.challengesBefore" "Data in proprietary formats" ) ;
        tuner:form ( "more.challengesCreating" "Difficult visualizations" ) ;
        tuner:form ( "more.getMost" "Use our Jupiter notebook" ) ;
        tuner:form ( "more.anythingElse" "sugus" ) ;
      ] ;
  ] ;
  tuner:formula {
    <#successComplete> <#request> ?req .
    ?req tuner:response ?res .

    ?res tuner:http_code 200 .
  } ;
.

