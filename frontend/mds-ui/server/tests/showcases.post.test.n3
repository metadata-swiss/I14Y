PREFIX log: <http://www.w3.org/2000/10/swap/log#>
PREFIX math: <http://www.w3.org/2000/10/swap/math#>
prefix xsd: <http://www.w3.org/2001/XMLSchema#>
PREFIX string: <http://www.w3.org/2000/10/swap/string#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX tuner: <https://api-tuner.described.at/>
PREFIX resource: <https://api-tuner.described.at/resource#>
PREFIX earl: <http://www.w3.org/ns/earl#>

<#success>
  a earl:TestCase ;
  rdfs:label "Submitted successfully (minimal)" ;
  <#request> [
    a tuner:Request ;
      tuner:url </api/showcases> ;
      tuner:method "POST" ;
      tuner:header ( "Accept-Language" "de" ) ;
      tuner:body [
        tuner:form ( "title" "Test: Complete" ) ;
        tuner:form ( "type" "https://opendata.swiss/vocabulary/showcase-type/application" ) ;
        tuner:form ( "url" "http://example.com/showcase" ) ;
        tuner:form ( "images" <file:assets/Rdf_logo.svg.png> ) ;
        tuner:form ( "datasets[https://opendata.swiss/set/data/hepatitis_b-abteilung-uebertragbare-krankheiten]" "Hepatitis B" ) ;
        tuner:form ( "themes" "http://publications.europa.eu/resource/authority/data-theme/INTR" ) ;
        tuner:form ( "createdBy" "John Doe" ) ;
        tuner:form ( "contactDetails.name" "John Doe" ) ;
        tuner:form ( "contactDetails.email" "test-complete@john.doe" ) ;
        tuner:form ( "contactDetails.github" "jd" ) ;
      ] ;
  ] ;
  tuner:formula {
    <#success> <#request> ?req .
    ?req tuner:response ?res .

    ?res tuner:http_code 200 .

    ?res tuner:jsonPath ( "$.slug" "test:-complete") .
    ?res tuner:jsonPath ( "$.de.active" "true") .
    ?res tuner:jsonPath ( "$.de.pinned" "false") .
    ?res tuner:jsonPath ( "$.de.themes" '["http://publications.europa.eu/resource/authority/data-theme/INTR"]') .
    ?res tuner:jsonPath ( "$.de.datasets.[0].id" "https://opendata.swiss/set/data/hepatitis_b-abteilung-uebertragbare-krankheiten") .
    ?res tuner:jsonPath ( "$.de.datasets.[0].label" "Hepatitis B") .
    ?res tuner:jsonPath ( "$.de.type" "https://opendata.swiss/vocabulary/showcase-type/application") .
    ?res tuner:jsonPath ( "$.de.createdBy" "John Doe") .
    ?res tuner:jsonPath ( "$.de.relationships.length" "1") .
    ?res tuner:jsonPath ( "$.de.relationships.[0].type" "person") .
    ?res tuner:jsonPath ( "$.de.relationships.[0].role" "pointOfContact") .
    ?res tuner:jsonPath ( "$.de.relationships.[0].name" "John Doe") .
    ?res tuner:jsonPath ( "$.de.relationships.[0].email" "") . # email cannot be stored
    ?res tuner:jsonPath ( "$.de.relationships.[0].github" "jd") .
    ?res tuner:jsonPath ( "$.de.images.[0].image" "Rdf_logo.svg.png" string:endsWith ) .

    ( <http://localhost:8025/api/v1/messages?query=from:test-complete@john.doe> ?messages ) resource:getIn [] .
    ?messages tuner:jsonPath ( "$.total" ?total ) .
    ( ?total xsd:integer ) log:dtlit ?totalInt .
    { ?totalInt math:greaterThan 0 } tuner:assertThat "Notification email should have been sent" .
  } ;
.

<#successMultipleDatasets>
  a earl:TestCase ;
  rdfs:label "Submitted successfully (multiple datasets)" ;
  <#request> [
    a tuner:Request ;
      tuner:url </api/showcases> ;
      tuner:method "POST" ;
      tuner:header ( "Accept-Language" "de" ) ;
      tuner:body [
        tuner:form ( "title" "Test: Multiple datasets" ) ;
        tuner:form ( "type" "https://opendata.swiss/vocabulary/showcase-type/application" ) ;
        tuner:form ( "url" "http://example.com/showcase" ) ;
        tuner:form ( "images" <file:assets/Rdf_logo.svg.png> ) ;
        tuner:form ( "datasets[https://opendata.swiss/set/data/hepatitis_a-abteilung-uebertragbare-krankheiten]" "Hepatitis A" ) ;
        tuner:form ( "datasets[https://opendata.swiss/set/data/hepatitis_b-abteilung-uebertragbare-krankheiten]" "Hepatitis B" ) ;
        tuner:form ( "datasets[https://opendata.swiss/set/data/hepatitis_c-abteilung-uebertragbare-krankheiten]" "Hepatitis C" ) ;
        tuner:form ( "themes" "http://publications.europa.eu/resource/authority/data-theme/INTR" ) ;
        tuner:form ( "createdBy" "John Doe" ) ;
        tuner:form ( "contactDetails.name" "John Doe" ) ;
        tuner:form ( "contactDetails.email" "john@Doe.pro" ) ;
        tuner:form ( "contactDetails.github" "jd" ) ;
      ] ;
  ] ;
  tuner:formula {
    <#successMultipleDatasets> <#request> ?req .
    ?req tuner:response ?res .

    ?res tuner:http_code 200 .

    ?res tuner:jsonPath ( "$.de.datasets.[0].id" "https://opendata.swiss/set/data/hepatitis_a-abteilung-uebertragbare-krankheiten") .
    ?res tuner:jsonPath ( "$.de.datasets.[0].label" "Hepatitis A") .

    ?res tuner:jsonPath ( "$.de.datasets.[1].id" "https://opendata.swiss/set/data/hepatitis_b-abteilung-uebertragbare-krankheiten") .
    ?res tuner:jsonPath ( "$.de.datasets.[1].label" "Hepatitis B") .

    ?res tuner:jsonPath ( "$.de.datasets.[2].id" "https://opendata.swiss/set/data/hepatitis_c-abteilung-uebertragbare-krankheiten") .
    ?res tuner:jsonPath ( "$.de.datasets.[2].label" "Hepatitis C") .
  } ;
.

