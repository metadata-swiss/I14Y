{
  "title": "bfs-iop-ui",
  "name": "bfs-iop-ui",
  "version": "0.0.0",
  "scripts": {
    "start": "node ./node_modules/@angular/cli/bin/ng serve",
    "build": "node ./node_modules/@angular/cli/bin/ng build",
    "build-prod": "node ./node_modules/@angular/cli/bin/ng build --configuration production --aot --delete-output-path --verbose",
    "version": "node ./node_modules/@angular/cli/bin/ng --version",
    "lint": "ng lint",
    "lint:fix": "npm run lint -- --fix",
    "prettier": "npx prettier --write src/**/{*.ts,*.html}",
    "audit": "npm audit --audit-level=high",
    "format": "npm run lint:fix && npm run prettier",
    "api:generated": "node -e \"require('fs').cpSync('../../build/ts-client/generated','api-client/lib/generated',{recursive:true,force:true})\""
  },
  "private": true,
  "dependencies": {
    "@angular/cdk": "~21.2.14",
    "@angular/common": "~21.2.19",
    "@angular/compiler": "~21.2.19",
    "@angular/core": "~21.2.19",
    "@angular/forms": "~21.2.19",
    "@angular/localize": "~21.2.19",
    "@angular/material": "~21.2.14",
    "@angular/platform-browser": "~21.2.19",
    "@angular/router": "~21.2.19",
    "@foblex/2d": "~1.2.2",
    "@foblex/drag-toolkit": "~1.1.1",
    "@foblex/flow": "~18.5.0",
    "@foblex/flow-elk-layout": "^18.6.0",
    "@foblex/mediator": "~1.1.2",
    "@foblex/platform": "~1.0.4",
    "@foblex/utils": "~1.1.1",
    "@ngx-translate/core": "~17.0.0",
    "@oblique/oblique": "15.4.4",
    "@typescript-eslint/utils": "^8.68.0",
    "angular-split": "~20.0.0",
    "date-fns": "^4.4.0",
    "fuse.js": "^7.3.0",
    "js-cookie": "^3.0.8",
    "jwt-decode": "4.0.0",
    "ngx-logger": "5.0.12",
    "ngx-matomo-client": "~9.0.1",
    "zone.js": "~0.16.1"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "~21.2.22",
    "@angular-devkit/core": "~21.2.20",
    "@angular-devkit/schematics": "~21.2.20",
    "@angular-eslint/builder": "~21.3.1",
    "@angular-eslint/eslint-plugin": "~21.3.1",
    "@angular-eslint/eslint-plugin-template": "~21.3.1",
    "@angular-eslint/schematics": "~21.3.1",
    "@angular-eslint/template-parser": "~21.3.1",
    "@angular/cli": "~21.2.20",
    "@angular/compiler-cli": "~21.2.19",
    "@popperjs/core": "~2.11.8",
    "@schematics/angular": "~21.2.20",
    "@types/node": "~25.5.0",
    "@typescript-eslint/eslint-plugin": "~8.68.0",
    "@typescript-eslint/parser": "~8.68.0",
    "ajv": "8.20.0",
    "ajv-formats": "~3.0.1",
    "commander": "14.0.3",
    "eslint": "~10.9.1",
    "eslint-config-prettier": "~10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "prettier": "~3.9.6",
    "rxjs": "~7.8.2",
    "typescript": "~5.9.3"
  },
  "overrides": {
    "esbuild": "0.28.1",
    "http-proxy-middleware": "3.0.7",
    "piscina": "5.2.0",
    "undici": "7.29.0"
  }
}
