{
  "title": "bfs-iop-admin-ui",
  "name": "bfs-iop-admin-ui",
  "version": "0.0.0",
  "scripts": {
    "start": "node ./node_modules/@angular/cli/bin/ng serve",
    "start-secure": "node ./node_modules/@angular/cli/bin/ng serve --ssl --ssl-cert ssl/localhost.crt --ssl-key ssl/localhost.key",
    "build": "node ./node_modules/@angular/cli/bin/ng build",
    "build-prod": "node ./node_modules/@angular/cli/bin/ng build --configuration production --aot --delete-output-path",
    "version": "node ./node_modules/@angular/cli/bin/ng --version",
    "lint": "ng lint",
    "lint:fix": "npm run lint -- --fix",
    "prettier": "npx prettier --write src/**/{*.ts,*.html}",
    "audit": "npm audit --audit-level=high",
    "format": "npm run lint:fix && npm run prettier",
    "api:generated": "node -e \"require('fs').cpSync('../../build/ts-client/generated','api-client/lib/generated',{recursive:true,force:true})\""
  },
  "private": true,
  "dependencies": {
    "@angular/cdk": "~21.2.14",
    "@angular/common": "~21.2.19",
    "@angular/compiler": "~21.2.19",
    "@angular/core": "~21.2.19",
    "@angular/forms": "~21.2.19",
    "@angular/localize": "~21.2.19",
    "@angular/material": "~21.2.14",
    "@angular/material-moment-adapter": "~21.2.14",
    "@angular/platform-browser": "~21.2.19",
    "@angular/router": "~21.2.19",
    "@foblex/2d": "~1.2.2",
    "@foblex/drag-toolkit": "~1.1.1",
    "@foblex/flow": "~18.5.0",
    "@foblex/flow-elk-layout": "^18.5.0",
    "@foblex/mediator": "~1.1.2",
    "@foblex/platform": "~1.0.4",
    "@foblex/utils": "~1.1.1",
    "@ngx-translate/core": "~17.0.0",
    "@oblique/oblique": "~15.1.3",
    "@typescript-eslint/utils": "^8.58.0",
    "date-fns": "^4.4.0",
    "fuse.js": "^7.3.0",
    "js-cookie": "~3.0.7",
    "jwt-decode": "~4.0.0",
    "ngx-logger": "~5.0.12",
    "oidc-client-ts": "^3.5.0",
    "tslib": "~2.8.1",
    "zone.js": "~0.16.1"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "~21.2.20",
    "@angular-devkit/core": "~22.1.3",
    "@angular-devkit/schematics": "~21.2.20",
    "@angular-eslint/builder": "21.3.1",
    "@angular-eslint/eslint-plugin": "21.3.1",
    "@angular-eslint/eslint-plugin-template": "21.3.1",
    "@angular-eslint/schematics": "21.3.1",
    "@angular-eslint/template-parser": "21.3.1",
    "@angular/build": "~21.2.20",
    "@angular/cli": "~21.2.20",
    "@angular/compiler-cli": "~21.2.19",
    "@popperjs/core": "^2.11.8",
    "@schematics/angular": "~21.2.20",
    "@types/jasmine": "~6.0.0",
    "@types/node": "^25.5.0",
    "@typescript-eslint/eslint-plugin": "^8.58.0",
    "@typescript-eslint/parser": "^8.58.0",
    "eslint": "^10.1.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "jasmine-core": "~6.1.0",
    "prettier": "^3.8.1",
    "rxjs": "^7.8.2",
    "typescript": "5.9.3"
  },
  "overrides": {
    "esbuild": "0.28.1",
    "http-proxy-middleware": "3.0.7",
    "piscina": "5.2.0",
    "undici": "7.29.0",
    "postcss": "8.5.18"
  }
}
