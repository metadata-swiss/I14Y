ARG NODE_IMAGE=node:24-bookworm-slim
FROM ${NODE_IMAGE}

WORKDIR /app/frontend/public-ui

COPY frontend/public-ui/package.json frontend/public-ui/package-lock.json ./
RUN npm ci

COPY build/ts-client/generated /app/build/ts-client/generated
COPY frontend/public-ui /app/frontend/public-ui
COPY docker/frontend/render-public-appconfig.mjs /app/scripts/render-appconfig.mjs

RUN npm run api:generated

EXPOSE 5022

CMD ["sh", "-c", "node /app/scripts/render-appconfig.mjs && npm run start -- --host 0.0.0.0 --port 5022"]
