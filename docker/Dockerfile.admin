# Stage 1: Build
FROM mcr.microsoft.com/dotnet/sdk:10.0 AS build
WORKDIR /backend

ARG ASSEMBLY_VERSION=1.0.0
ARG INFORMATIONAL_VERSION=0.0.0-alpha
ARG DOCKER_VERSION=1.0.0-1-build.1
ARG HTTP_PROXY=
ARG HTTPS_PROXY=
ARG NO_PROXY=
ARG CORPORATE_CA_FILE=
ARG CORPORATE_CA_CHAIN_FILE=

# Copy the solution file and all project files/folders into the container
COPY . .

# Configure proxy variables for restore only when provided.
ENV HTTP_PROXY=${HTTP_PROXY} \
	HTTPS_PROXY=${HTTPS_PROXY} \
	NO_PROXY=${NO_PROXY} \
	http_proxy=${HTTP_PROXY} \
	https_proxy=${HTTPS_PROXY} \
	no_proxy=${NO_PROXY}

# Import corporate CAs only when optional paths are provided and files exist.
RUN set -e; \
	certs_added=0; \
	if [ -n "${CORPORATE_CA_FILE}" ] && [ -f "${CORPORATE_CA_FILE}" ]; then cp "${CORPORATE_CA_FILE}" /usr/local/share/ca-certificates/corporate-ca.crt; certs_added=1; fi; \
	if [ -n "${CORPORATE_CA_CHAIN_FILE}" ] && [ -f "${CORPORATE_CA_CHAIN_FILE}" ]; then cp "${CORPORATE_CA_CHAIN_FILE}" /usr/local/share/ca-certificates/corporate-ca-chain.crt; certs_added=1; fi; \
	if [ "${certs_added}" = "1" ]; then update-ca-certificates; fi

RUN echo "AssemblyVersion: ${ASSEMBLY_VERSION}"
RUN echo "InformationalVersion: ${INFORMATIONAL_VERSION}"
RUN echo "DockerVersion: ${DOCKER_VERSION}"

# Restore dependencies for the API project
RUN dotnet restore backend/src/Admin/Bfs.Iop.Admin.Api/Bfs.Iop.Admin.Api.csproj

# Publish the API project
RUN dotnet publish backend/src/Admin/Bfs.Iop.Admin.Api/Bfs.Iop.Admin.Api.csproj -c Release -o /app/publish --no-restore /p:AssemblyVersion=${ASSEMBLY_VERSION} /p:InformationalVersion=${INFORMATIONAL_VERSION}

# Stage 2: Runtime image
FROM mcr.microsoft.com/dotnet/aspnet:10.0 AS final
WORKDIR /app

ARG DOCKER_VERSION=1.0.0-1-build.1

LABEL org.opencontainers.image.version=${DOCKER_VERSION}

ENV APP_VERSION=${DOCKER_VERSION}

# Copy published output from build container
COPY --from=build /app/publish .

# Expose port 80
EXPOSE 80

# Start the API
ENTRYPOINT ["dotnet", "Bfs.Iop.Admin.Api.dll"]