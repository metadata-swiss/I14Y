# Copy to .env and fill in the password, then: docker compose up -d --build
# .env is gitignored; never commit real credentials.

# Postgres that IOP Core uses locally. Defaults match the usual local setup; override if yours
# differs. POSTGRES_HOST is resolved from inside the container, so keep host.docker.internal when
# the database is reachable on the host.
POSTGRES_HOST=host.docker.internal
POSTGRES_PORT=15432
POSTGRES_DB=dsisbfsdcat
POSTGRES_USER=postgres
POSTGRES_PASSWORD=

# Must match IndexSearchClient:Secret in backend/src/Core/Bfs.Iop.Core.Api/appsettings.Development.json
INDEXSEARCH_SECRET=local-indexsearch-secret

# Set to false to skip the initial full index build (faster startup, empty index until you trigger
# a rebuild with POST /api/Index/rebuild).
INDEXSEARCH_BUILD_ON_STARTUP=true
INDEXSEARCH_FULL_REINDEX_INTERVAL_HOURS=6
